# Copy to .env only if your shell tooling loads .env files. Spring reads these names
# from the process environment; the application does not automatically load .env.
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-random-internal-service-key
AUTH_MYSQL_URL=jdbc:mysql://localhost:3306/authentication_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_MYSQL_USERNAME=proteinpro_auth
AUTH_MYSQL_PASSWORD=replace-with-local-auth-db-password
USER_PROFILE_MYSQL_URL=jdbc:mysql://localhost:3306/user_profile_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USER_PROFILE_MYSQL_USERNAME=proteinpro_profile
USER_PROFILE_MYSQL_PASSWORD=replace-with-local-profile-db-password
BOOKMARK_MONGODB_URI=mongodb://localhost:27017/proteinpro_bookmarks
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost
CONFIG_SERVER_URL=http://localhost:8888
PROTEIN_API_BASE_URL=http://localhost:3232
FRONTEND_ORIGIN=http://localhost:3000
JWT_EXPIRATION_SECONDS=1800
